# Standalone edge — Hearth alone, on :17012 unless start.ps1 -Bind says otherwise.
#
# Routes live in ./Caddyfile.snippet; this file is just the site block around
# them. Started by start.ps1, and skipped under `start.ps1 -NoCaddy`, when an
# external edge owns the port instead.
{
	auto_https off

	# Never used, and leaving it on binds 127.0.0.1:2019 — which collides with any
	# second Caddy on the box.
	admin off

	# Caddy shares the console with Hearth. Its start-up chatter (and the two
	# warnings about the choices above) would bury Hearth's own lines; a real
	# fault, such as the port being taken, is an error and still shows.
	#
	# The proxy handler's own log is left out: all it reports is a browser
	# hanging up mid-response ("aborting with incomplete response"), which is
	# how a video seeks and how a thumbnail scrolled away is cancelled. A
	# backend that cannot be reached is still reported, under http.log.error.
	log {
		level ERROR
		exclude http.handlers.reverse_proxy
	}
}

{$CADDY_BIND::17012} {
	import Caddyfile.snippet

	# The frontend lives under its prefix, so the bare root serves nothing.
	# Standalone, Hearth is the whole site. (Behind a shared edge the root belongs
	# to that edge — hence this lives here, not in the snippet.)
	handle / {
		redir * {$HEARTH_WEB_PREFIX:/hearth} permanent
	}

	# Anything the snippet did not claim. Without this Caddy answers an empty 200,
	# which looks like a working page.
	handle {
		respond "Not found" 404
	}
}
