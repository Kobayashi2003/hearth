{
  "name": "hearth",
  "version": "2.0.0",
  "description": "Hearth — your files, at home.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @hearth/shared build && pnpm -r --parallel dev",
    "start": "pnpm --filter @hearth/server start",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write \"{server,web,packages,test}/**/*.{ts,tsx,css}\" \"*.{ts,js,json}\"",
    "format:check": "prettier --check \"{server,web,packages,test}/**/*.{ts,tsx,css}\" \"*.{ts,js,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "ruffle": "node scripts/install-ruffle.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/react-query": "^5.101.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "adm-zip": "^0.5.18",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "iconv-lite": "^0.6.3",
    "jsdom": "^30.1.1",
    "pino": "^9.14.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
