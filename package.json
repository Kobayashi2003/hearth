{
  "name": "hearth",
  "version": "2.0.0",
  "description": "Hearth — your files, at home.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/shared",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w @hearth/shared && npm run build -w @hearth/server && npm run build -w @hearth/web",
    "predev": "npm run build -w @hearth/shared",
    "dev": "npm-run-all --parallel dev:shared dev:server dev:web",
    "start": "npm run start -w @hearth/server",
    "dev:shared": "npm run dev -w @hearth/shared",
    "dev:server": "npm run dev -w @hearth/server",
    "dev:web": "npm run dev -w @hearth/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write \"{server,web,packages,test}/**/*.{ts,tsx,css}\" \"*.{ts,js,json}\"",
    "format:check": "prettier --check \"{server,web,packages,test}/**/*.{ts,tsx,css}\" \"*.{ts,js,json}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.13.0",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^30.1.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  }
}
