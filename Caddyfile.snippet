# Route definitions for Hearth — the single source of truth, imported by every
# edge that fronts it: ./Caddyfile (standalone) and app-gateway (several apps
# sharing one public port).
#
# 127.0.0.1, not localhost: on Windows localhost resolves to ::1 first, and each
# cold connection to an IPv4-only listener would eat a ~20 s IPv6 timeout.
#
# Rules for anything added here:
#   - No matcher-less `handle`. Under app-gateway the catch-all is the landing
#     page, and one here would swallow the other apps' traffic.
#   - Prefix named matchers with the app (@hearth_*). Under app-gateway every
#     app's snippet is imported into one site block, and matcher names are scoped.

# Backend API. Binds loopback and is reachable only through here. The prefix is
# app-scoped (/hearth-api) rather than a generic /api because under the
# app-gateway every app's snippet is imported into one site block on one origin,
# and a generic prefix would collide. It is NOT stripped — the backend mounts
# its routes under /hearth-api.
#
# Media streams (/hearth-api/media/raw, /media/transcode, /download/*) go through
# here too. flush_interval -1 streams rather than buffers, so long-lived Range
# connections are not dropped under backpressure — the whole reason the frontend
# is a static SPA with nothing of its own in the byte path.
handle /hearth-api/* {
	reverse_proxy {$HEARTH_BACKEND_UPSTREAM:127.0.0.1:5111} {
		flush_interval -1
	}
}

# Frontend: static assets served directly by Caddy — there is no frontend server
# process any more.
#
# Bare /hearth redirects to /hearth/ first. index.html references its assets
# relatively (./assets/…) so one build works under any prefix; the browser
# resolves those against the document's directory, which is only "/hearth/" when
# the URL ends in a slash. Without the redirect, /hearth resolves ./assets to
# the origin root and every asset 404s (a black screen).
redir /hearth /hearth/ 308

# Everything under /hearth/. handle_path strips the matched /hearth prefix so
# paths resolve against web/dist; a path that is not a real file falls back to
# index.html for the hash-routed SPA. It does not match /hearth-api, whose path
# does not begin with "/hearth/".
handle_path /hearth/* {
	root * {$HEARTH_WEB_ROOT:./web/dist}

	# Asset filenames carry a content hash, so a given URL never changes meaning:
	# cache it for a year and let a new build produce a new name.
	@hearth_assets path /assets/*
	header @hearth_assets Cache-Control "public, max-age=31536000, immutable"

	# index.html is the one file whose name never changes, and it is what names
	# the hashed assets. Without an explicit header a browser is free to guess a
	# freshness lifetime for it — and a browser that guesses keeps loading the
	# previous build after a deploy, asking for asset files that are no longer
	# there. `no-cache` means "keep it, but ask every time", so a revalidation is
	# a 304 when nothing changed and the new document when something did.
	@hearth_document not path /assets/*
	header @hearth_document Cache-Control "no-cache"

	try_files {path} /index.html
	file_server
}
