# Hearth configuration. Copy to .env and adjust; every variable is optional and
# the value shown is the default.
#
# Precedence, highest first: the process environment, then .env.development
# (only under `pnpm dev`; it lifts every limit), then this file (.env).
#
# Limits: every variable marked [limit] is a non-negative integer where 0 means
# unlimited. Variables marked [safeguard] are positive integers with no
# unlimited setting; they protect the server and stay in force in development.
# While Hearth is under development the local .env sets every [limit] to 0,
# as .env.development does; the values below are the defaults when unset.
#
# Variables marked [settings] are where Hearth starts: an administrator can
# change them in Settings while it runs, and that choice wins until it is reset
# there. Ordinary users never see or change them.

# ── Server ──────────────────────────────────────────────────────────────────
HEARTH_PORT=17010
# Loopback only: the Caddy edge is the only public door.
HEARTH_HOST=127.0.0.1
HEARTH_CORS_ORIGIN=http://localhost:17011
# App-scoped, not /api: behind a shared edge every app shares one origin.
# Caddy (via caddy-env.ps1) and the dev proxy follow it; for a production
# build also set HEARTH_WEB_API_BASE to the same value.
HEARTH_API_PREFIX=/hearth-api
# Where Caddy mounts the web app.
HEARTH_WEB_PREFIX=/hearth
# [limit] Largest JSON request body, MB.
HEARTH_API_BODY_LIMIT_MB=2

# ── Storage ─────────────────────────────────────────────────────────────────
# Comma-separated paths to serve. The first is active at startup unless
# HEARTH_BASE_DIRECTORY names another one.
HEARTH_ROOT_DIRECTORIES=./example
# HEARTH_BASE_DIRECTORY=./example
HEARTH_DATA_DIRECTORY=./server/data
HEARTH_TEMP_DIRECTORY=./server/temp
HEARTH_BACKGROUNDS_DIRECTORY=./server/backgrounds
# Read-buffer bytes per stream kind.
HEARTH_STREAM_BUFFER_VIDEO=1048576
HEARTH_STREAM_BUFFER_AUDIO=262144
HEARTH_STREAM_BUFFER_DEFAULT=65536

# ── Accounts and sessions ───────────────────────────────────────────────────
# "user:password:permissions" joined by ';'. Permissions: r w d a.
# Passwords may be plain text or a bcrypt hash. Change this before serving anything real.
HEARTH_USER_RULES=admin:hearth:rwda
HEARTH_USERS_FILE=./server/data/users.json
HEARTH_PERMISSIONS_FILE=./server/data/permissions.json
# [limit] Session lifetime, hours.
HEARTH_SESSION_EXPIRY_HOURS=24
HEARTH_SESSION_COOKIE_NAME=hearth_session
# true when served over HTTPS end to end.
HEARTH_SESSION_COOKIE_SECURE=false
# Set to keep sessions across restarts.
# HEARTH_REDIS_URL=redis://127.0.0.1:6379
# Set to keep media links valid across restarts; otherwise random per boot.
# HEARTH_MEDIA_TOKEN_SECRET=
# [limit] Media link lifetime, seconds.
HEARTH_MEDIA_TOKEN_TTL=3600
# [settings] Start with only administrators allowed in.
HEARTH_ADMIN_ONLY_MODE=false

# ── Listing and batch operations ────────────────────────────────────────────
# [limit, settings] Entries returned for one folder or one search; past it the UI says it shows a prefix.
HEARTH_LISTING_MAX_ENTRIES=20000
# [limit] Paths in one copy/move/delete/zip/restore, and rules in one permission save.
HEARTH_BATCH_MAX_ITEMS=1000

# ── Upload and download ─────────────────────────────────────────────────────
# [limit, settings] Size of one uploaded file, MB.
HEARTH_MAX_UPLOAD_SIZE_MB=10240
# [limit] Files in one multipart request.
HEARTH_MAX_UPLOAD_FILES=0
HEARTH_CHUNK_UPLOAD_DIR=./server/temp/chunks
HEARTH_CHUNK_SIZE_MB=10
# [limit] Unfinished resumable uploads are removed after this many hours.
HEARTH_CHUNK_UPLOAD_TIMEOUT_HOURS=24
# Reject a file whose content contradicts its extension.
HEARTH_MAGIC_NUMBER_VALIDATION=false
# [limit] How long a multi-file ZIP download link stays valid, minutes.
HEARTH_ZIP_LINK_TTL_MINUTES=5

# ── Recycle bin ─────────────────────────────────────────────────────────────
# [settings] Deleting moves items here rather than removing them.
HEARTH_RECYCLE_BIN_ENABLED=true
HEARTH_RECYCLE_BIN_DIRECTORY=./server/data/trash
HEARTH_RECYCLE_BIN_AUTO_CLEANUP=true
# [limit, settings] Days an item is kept.
HEARTH_RECYCLE_BIN_RETENTION_DAYS=30
# [limit, settings] Total size kept, MB; the oldest go first.
HEARTH_RECYCLE_BIN_MAX_SIZE_MB=1024

# ── Search ──────────────────────────────────────────────────────────────────
# auto = Everything when reachable, else a folder walk. everything | walk | auto
HEARTH_SEARCH_PROVIDER=auto
# Keep it on 127.0.0.1: Everything's HTTP server serves files without authentication.
HEARTH_EVERYTHING_URL=http://127.0.0.1:8081
# HEARTH_EVERYTHING_USERNAME=
# HEARTH_EVERYTHING_PASSWORD=
# [safeguard, settings] Per-query timeout, ms; a hung Everything must not hang every search.
HEARTH_EVERYTHING_TIMEOUT_MS=5000
# [limit, settings] Matches one search may return (Everything and walk alike).
HEARTH_SEARCH_MAX_RESULTS=10000
# [limit] Characters in a search query.
HEARTH_SEARCH_MAX_QUERY_LENGTH=512
HEARTH_SEARCH_PROBE_COOLDOWN_MS=5000

# ── Media and documents ─────────────────────────────────────────────────────
HEARTH_FFMPEG_PATH=ffmpeg
HEARTH_FFPROBE_PATH=ffprobe
HEARTH_TRANSCODE_CRF=23
HEARTH_TRANSCODE_PRESET=veryfast
HEARTH_THUMBNAIL_CACHE_DIR=./server/temp/thumbnails
HEARTH_COMIC_CACHE_DIR=./server/temp/comics
HEARTH_PSD_CACHE_DIR=./server/temp/psd
HEARTH_SUBTITLE_CACHE_DIR=./server/temp/subtitles
# [limit] Widest thumbnail a client may request, px.
HEARTH_THUMBNAIL_MAX_WIDTH=2048
# [limit, settings] Largest text file read whole, MB; past it only the beginning is shown.
HEARTH_MAX_TEXT_SIZE_MB=8
# [limit] Largest text file that can be saved from the editor, MB.
HEARTH_MAX_TEXT_SAVE_SIZE_MB=32
# [limit, settings] Entries listed for one archive.
HEARTH_ARCHIVE_MAX_ENTRIES=5000
# [limit, settings] Largest single archive member opened in place, MB.
HEARTH_ARCHIVE_MAX_MEMBER_SIZE_MB=64
# [safeguard, settings] How deep and how wide to look inside a folder for its
# cover; on a large tree an unbounded scan would walk the whole drive for one tile.
HEARTH_FOLDER_COVER_MAX_DEPTH=2
HEARTH_FOLDER_COVER_MAX_BRANCHES=6
# ── Web pages ───────────────────────────────────────────────────────────────
# [settings] Open .html files at all.
HEARTH_HTML_VIEWER_ENABLED=true
# [settings] Serve a page with the files beside it (images, styles, frames,
# linked pages), from its own folder down; off, a page is shown on its own.
HEARTH_HTML_LOCAL_RESOURCES=true
# [settings] Let pages load images and styles from other sites.
HEARTH_HTML_EXTERNAL_RESOURCES=false
# [settings] Run a page's own scripts, sandboxed away from Hearth (needs local resources).
HEARTH_HTML_SCRIPTS=false
# [settings] Play Flash embedded in pages with Ruffle (needs local resources).
HEARTH_HTML_RUFFLE=false
# [settings] Play video a page embeds for an old plugin (QuickTime, Windows
# Media) in the browser's own player, transcoding what it cannot decode
# (needs local resources; costs CPU while such a video plays).
HEARTH_HTML_VIDEO=false
# Where the self-hosted Ruffle build lives; `pnpm ruffle` downloads it here.
HEARTH_RUFFLE_DIRECTORY=./web/public/ruffle

# ── Caches ──────────────────────────────────────────────────────────────────
# [limit] Days before a cached thumbnail / comic / PSD render is pruned.
HEARTH_CACHE_THUMBNAIL_DAYS=30
HEARTH_CACHE_COMIC_DAYS=7
HEARTH_CACHE_PSD_DAYS=7
HEARTH_CACHE_SUBTITLE_DAYS=30

# ── Reading positions (Ledger) ──────────────────────────────────────────────
# [limit] Positions kept per user; the oldest go first.
HEARTH_LEDGER_MAX_PROGRESS=1000
# [limit] EPUB reading sessions kept per user.
HEARTH_LEDGER_MAX_SESSIONS=300
# [limit] Size of one reading session (position, bookmarks, highlights), KB.
HEARTH_LEDGER_SESSION_MAX_KB=512

# ── Rate limits (requests per window, per client IP) ────────────────────────
# [limit] each *_MAX; windows are minutes.
HEARTH_RATE_LIMIT_GLOBAL_MAX=1000
HEARTH_RATE_LIMIT_GLOBAL_WINDOW_MINUTES=1
HEARTH_RATE_LIMIT_WRITE_MAX=100
HEARTH_RATE_LIMIT_WRITE_WINDOW_MINUTES=1
HEARTH_RATE_LIMIT_SEARCH_MAX=50
HEARTH_RATE_LIMIT_SEARCH_WINDOW_MINUTES=1
HEARTH_RATE_LIMIT_LOGIN_MAX=10
HEARTH_RATE_LIMIT_LOGIN_WINDOW_MINUTES=5

# ── Logging ─────────────────────────────────────────────────────────────────
# info: start-up, changes, refusals, faults and ordinary requests. Thumbnails,
# file bytes and requests the browser abandoned (a tile scrolled away) are
# debug, or a folder of thousands would fill the console.
# One of trace, debug, info, warn, error, fatal, silent.
HEARTH_LOG_LEVEL=info
# Console: pretty (one readable line each) or json (for a log collector).
# The file is always JSON, rotated daily as hearth.<date>.<n>.log, 14 kept.
HEARTH_LOG_FORMAT=pretty
HEARTH_LOG_TO_FILE=true
HEARTH_LOG_DIRECTORY=./server/logs

# ── Web app (build time; only HEARTH_WEB_* reaches the browser bundle) ──────
# HEARTH_WEB_API_BASE=/hearth-api
# [limit] Characters beyond which a text file is shown without highlighting.
HEARTH_WEB_MAX_HIGHLIGHT_CHARS=400000
# [limit] Files uploaded at the same time.
HEARTH_WEB_PARALLEL_UPLOADS=2

# ── Development only ────────────────────────────────────────────────────────
# Where the Vite dev server proxies the API; defaults to 127.0.0.1:$HEARTH_PORT.
# HEARTH_DEV_API=http://127.0.0.1:17010
HEARTH_DEV_WEB_PORT=17011
