# Hearth configuration. Copy to .env and adjust.
# Every variable is optional; the value shown is the default.

# ── Server ──────────────────────────────────────────────────────────────────
HEARTH_PORT=5111
HEARTH_HOST=127.0.0.1
HEARTH_CORS_ORIGIN=http://localhost:5110
# App-scoped, not a generic /api: every app shares one origin under app-gateway.
HEARTH_API_PREFIX=/hearth-api

# ── Storage ─────────────────────────────────────────────────────────────────
# Comma-separated absolute paths. The first is active at startup unless
# HEARTH_BASE_DIRECTORY names another one.
HEARTH_ROOT_DIRECTORIES=./example
# HEARTH_BASE_DIRECTORY=./example
HEARTH_DATA_DIRECTORY=./server/data
HEARTH_TEMP_DIRECTORY=./server/temp
HEARTH_BACKGROUNDS_DIRECTORY=./server/backgrounds

# ── Authentication ──────────────────────────────────────────────────────────
# "user:password:permissions" entries joined by ';'. Permissions: r w d a.
# Passwords may be plain text or a bcrypt hash.
HEARTH_USER_RULES=admin:hearth:rwda
HEARTH_SESSION_EXPIRY_HOURS=24
# Set to survive a restart; otherwise a new secret is generated each boot.
# HEARTH_MEDIA_TOKEN_SECRET=
# HEARTH_REDIS_URL=redis://127.0.0.1:6379

# ── Search (Everything) ─────────────────────────────────────────────────────
# auto = use Everything when reachable, fall back to a filesystem walk.
HEARTH_SEARCH_PROVIDER=auto
HEARTH_EVERYTHING_URL=http://127.0.0.1:8081
# HEARTH_EVERYTHING_USERNAME=
# HEARTH_EVERYTHING_PASSWORD=

# ── Logging ─────────────────────────────────────────────────────────────────
HEARTH_LOG_LEVEL=info
HEARTH_LOG_TO_FILE=true
